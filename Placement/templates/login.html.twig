<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Connexion - {{ nom_projet }}</title>
    
    <link rel="stylesheet" href="/css/s_stage1.css">
    
    <style>
        .login-box {
            max-width: 400px;
            margin: 80px auto;
            padding: 30px;
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        .login-box h2 { color: #1f4d75; text-align: center; margin-bottom: 25px; }
        .form-group { margin-bottom: 20px; }
        .form-group label { display: block; margin-bottom: 8px; font-weight: 600; color: #444; }
        .form-group input { 
            width: 100%; padding: 12px; border: 1px solid #ddd; 
            border-radius: 8px; box-sizing: border-box; transition: border 0.3s;
        }
        .form-group input:focus { border-color: #1f4d75; outline: none; }
        .btn-login { 
            width: 100%; padding: 12px; background: #1f4d75; color: white; 
            border: none; border-radius: 8px; font-weight: bold; cursor: pointer; font-size: 16px;
        }
        .btn-login:hover { background: #153a5a; }
        .error-msg { color: #c0392b; background: #f9d9d9; padding: 10px; border-radius: 5px; margin-bottom: 15px; text-align: center; }
    </style>
</head>
<body>

    <div class="login-box">
        <h2>Connexion</h2>

        {% if error %}
            <div class="error-msg">{{ error }}</div>
        {% endif %}

        <form action="index.php?p=login_verify" method="POST">
            <div class="form-group">
                <label>Identifiant</label>
                <input type="text" name="text" placeholder="" required>
            </div>
            
            <div class="form-group">
                <label>Mot de passe</label>
                <input type="password" name="password" placeholder="••••••••" required>
            </div>

            <button type="submit" class="btn-login">Se connecter</button>
        </form>
    </div>

</body>
</html>