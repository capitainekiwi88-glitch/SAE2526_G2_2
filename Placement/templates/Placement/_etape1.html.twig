<section class="stage-panel">
    <div class="section-head">
        <div>
            <h2>Informations sur le devoir :</h2>
        </div>
        <form method="post">
        </form>
    </div>

    <div class="setup-layout">
        <form method="post" class="panel" id="placementSetupForm" novalidate>
            <div class="form-grid">
                <div class="field field-date">
                    <div class="field-head">
                        <label for="date_exam">Date du devoir</label>
                        <div class="field-error" id="date-error-message" {% if not date_error %}style="display:none;"{% endif %}>{{ date_error }}</div>
                    </div>
                    <input type="date" id="date_exam" name="date_exam" value="{{ exam.date ?: today_iso }}" min="{{ today_iso }}">
                </div>
                <div class="field field-start">
                    <label>Heure de début</label>
                    <div class="subgrid">
                        {% for select_name, values in {
                            'start_hour': 8..18,
                            'start_minute': ['00', '15', '30', '45']
                        } %}
                            <select name="{{ select_name }}">
                                {% for value in values %}
                                    {% set option_value = value is iterable ? value : '%02d'|format(value) %}
                                    <option value="{{ option_value }}" {{ attribute(exam, select_name) == option_value ? 'selected' }}>{{ select_name == 'start_hour' ? option_value ~ ' h' : option_value }}</option>
                                {% endfor %}
                            </select>
                        {% endfor %}
                    </div>
                </div>
                <div class="field field-duration">
                    <label>Durée</label>
                    <div class="subgrid">
                        {% for select_name, values in {
                            'duration_hour': 0..6,
                            'duration_minute': ['00', '15', '30', '45']
                        } %}
                            <select name="{{ select_name }}">
                                {% for value in values %}
                                    {% set option_value = value is iterable ? value : '%02d'|format(value) %}
                                    <option value="{{ option_value }}" {{ attribute(exam, select_name) == option_value ? 'selected' }}>{{ select_name == 'duration_hour' ? option_value ~ ' h' : option_value }}</option>
                                {% endfor %}
                            </select>
                        {% endfor %}
                    </div>
                </div>
                <div class="field field-promo">
                    <label for="promo_id">Promotion</label>
                    <select id="promo_id" name="promo_id">
                        <option value="" {{ form.promo_id == '' ? 'selected' }}>--</option>
                        {% for promo in promotions %}
                            <option value="{{ promo.id }}" {{ form.promo_id == (promo.id ~ '') ? 'selected' }}>{{ promo.label }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="field field-group is-hidden" id="field-group">
                    <label for="group_id">Groupe</label>
                    <select id="group_id" name="group_id">
                        <option value="0" {{ form.group_id == '0' ? 'selected' }}>--</option>
                        {% for groupe in groupes %}
                            <option value="{{ groupe.id }}" data-promo="{{ groupe.promo_id }}" {{ form.group_id == (groupe.id ~ '') ? 'selected' }}>{{ groupe.label }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="field field-matiere is-hidden" id="field-matiere">
                    <label for="matiere_id">Matière</label>
                    <select id="matiere_id" name="matiere_id">
                        <option value="" {{ form.matiere_id == '' ? 'selected' }}>--</option>
                        {% for matiere in matieres %}
                            <option value="{{ matiere.id }}" data-promo="{{ matiere.promo_id }}" {{ form.matiere_id == (matiere.id ~ '') ? 'selected' }}>{{ matiere.nom }} · {{ matiere.promo_label }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="field field-salle is-hidden" id="field-salle">
                    <label for="salle_id">Salle</label>
                    <select id="salle_id" name="salle_id">
                        <option value="" {{ form.salle_id == '' ? 'selected' }}>--</option>
                        {% for salle in salles %}
                            <option value="{{ salle.id }}" {{ form.salle_id == (salle.id ~ '') ? 'selected' }}>{{ salle.nom }} · {{ salle.batiment }} · {{ salle.capacite }} places</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="field field-actions">
                    <div class="field-actions-row">
                        <div class="field-error" id="form-error-message" {% if not form_error %}style="display:none;"{% endif %}>{{ form_error }}</div>
                        <div class="toolbar" style="margin-top:0;">
                            <button class="btn primary" id="add-combination-btn" type="submit" name="action" value="add_combination" disabled>+ Ajouter</button>
                        </div>
                    </div>
                </div>
            </div>
        </form>

        <div class="panel">
            <div class="section-head" style="margin-bottom:14px;">
                <div>
                    <h2 style="font-size:1.15rem;">Récapitulatif :</h2>
                </div>
            </div>

            <div id="combination-summary">
            {% if combinations %}
                <table class="combo-table">
                    <thead>
                        <tr>
                            <th>Promotion</th>
                            <th>Groupe</th>
                            <th>Matière</th>
                            <th>Étudiants</th>
                            <th>Places libres</th>
                            <th>Salle</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for combination in combinations %}
                            <tr>
                                <td><span class="badge primary">{{ combination.promo_label }}</span></td>
                                <td><span class="badge neutral">{{ combination.group_label }}</span></td>
                                <td>{{ combination.matiere_label }}</td>
                                <td>{{ combination.student_count }}</td>
                                <td>{{ combination.free_seats }} / {{ combination.total_seats }}</td>
                                <td><span class="badge success">{{ combination.salle_label }}</span></td>
                                <td style="text-align:right;">
                                    <form method="post" class="remove-combination-form">
                                        <input type="hidden" name="combination_id" value="{{ combination.id }}">
                                        <button class="btn-icon" type="submit" name="action" value="remove_combination" title="Retirer">
                                            <svg width="18" height="18" fill="none" stroke="#ef4444" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                                                <path d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                            </svg>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% else %}
                <div class="empty-state">
                    Aucun étudiants n'a été ajouté.
                </div>
            {% endif %}
            </div>
        </div>
    </div>

    <div class="stage-footer">
        <button class="btn primary" id="generate-placements-btn" type="submit" name="action" value="generate_placements" form="placementSetupForm" {{ combinations is empty ? 'disabled' }}> --> Passer à l'étape suivante</button>
    </div>
</section>
