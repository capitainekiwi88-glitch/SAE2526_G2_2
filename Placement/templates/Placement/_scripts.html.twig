<script>
    (function () {
        let existingCombinations = {{ combinations|json_encode|raw }};
        const studentCounts = {{ student_counts|json_encode|raw }};
        const sallesData = {{ salles|json_encode|raw }};
        const promoSelect = document.getElementById('promo_id');
        const groupSelect = document.getElementById('group_id');
        const matiereSelect = document.getElementById('matiere_id');
        const salleSelect = document.getElementById('salle_id');
        const fieldGroup = document.getElementById('field-group');
        const fieldMatiere = document.getElementById('field-matiere');
        const fieldSalle = document.getElementById('field-salle');
        const addCombinationButton = document.getElementById('add-combination-btn');
        const formErrorMessage = document.getElementById('form-error-message');
        const dateErrorMessage = document.getElementById('date-error-message');
        const dateExamInput = document.getElementById('date_exam');
        const placementSetupForm = document.getElementById('placementSetupForm');
        const combinationSummary = document.getElementById('combination-summary');
        const generatePlacementsButton = document.getElementById('generate-placements-btn');

        function escapeHtml(value) {
            return String(value)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }

        function updateCombinationSummary(combinations) {
            if (!combinationSummary) return;

            if (!combinations.length) {
                combinationSummary.innerHTML = "<div class=\"empty-state\">Aucun étudiants n'a été ajouté.</div>";
                if (generatePlacementsButton) generatePlacementsButton.disabled = true;
                return;
            }

            const rows = combinations.map((combination) => `
                <tr>
                    <td><span class="badge primary">${escapeHtml(combination.promo_label)}</span></td>
                    <td><span class="badge neutral">${escapeHtml(combination.group_label)}</span></td>
                    <td>${escapeHtml(combination.matiere_label)}</td>
                    <td>${escapeHtml(combination.student_count)}</td>
                    <td>${escapeHtml(combination.free_seats)} / ${escapeHtml(combination.total_seats)}</td>
                    <td><span class="badge success">${escapeHtml(combination.salle_label)}</span></td>
                    <td style="text-align:right;">
                        <form method="post" class="remove-combination-form">
                            <input type="hidden" name="combination_id" value="${escapeHtml(combination.id)}">
                            <button class="btn-icon" type="submit" name="action" value="remove_combination" title="Retirer">
                                <svg width="18" height="18" fill="none" stroke="#ef4444" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                </svg>
                            </button>
                        </form>
                    </td>
                </tr>
            `).join('');

            combinationSummary.innerHTML = `
                <table class="combo-table">
                    <thead>
                        <tr>
                            <th>Promotion</th>
                            <th>Groupe</th>
                            <th>Matière</th>
                            <th>Étudiants</th>
                            <th>Places libres</th>
                            <th>Salle</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>${rows}</tbody>
                </table>
            `;

            if (generatePlacementsButton) generatePlacementsButton.disabled = false;
        }

        function filterSelect(select, promoId, keepAllOption) {
            if (!select) return;

            const options = Array.from(select.querySelectorAll('option'));
            let firstVisibleValue = keepAllOption ? '0' : null;

            options.forEach((option) => {
                if (!option.dataset.promo) return;
                const visible = option.dataset.promo === promoId;
                option.hidden = !visible;
                if (visible && firstVisibleValue === null) {
                    firstVisibleValue = option.value;
                }
            });

            const selected = select.options[select.selectedIndex];
            if (!selected || selected.hidden) {
                select.value = keepAllOption ? '0' : '';
            }
        }

        function updateAddButtonState() {
            if (!addCombinationButton) return;

            const canAdd = !!promoSelect
                && promoSelect.value !== ''
                && !!groupSelect
                && groupSelect.value !== '0'
                && !!matiereSelect
                && matiereSelect.value !== ''
                && !!salleSelect
                && salleSelect.value !== '';
            const isDateValid = validateExamDate();
            const errorMessage = evaluateCombinationError();
            renderFormError(errorMessage);
            const hasBlockingError = errorMessage !== '';

            addCombinationButton.disabled = !canAdd || hasBlockingError || !isDateValid;
        }

        function renderFormError(message) {
            if (!formErrorMessage) return;
            formErrorMessage.textContent = message;
            formErrorMessage.style.display = message ? 'block' : 'none';
        }

        function renderDateError(message) {
            if (!dateErrorMessage) return;
            dateErrorMessage.textContent = message;
            dateErrorMessage.style.display = message ? 'block' : 'none';
        }

        function validateExamDate() {
            if (!dateExamInput) return true;
            if (!dateExamInput.value) {
                renderDateError('');
                return true;
            }

            if (!/^\d{4}-\d{2}-\d{2}$/.test(dateExamInput.value)) {
                renderDateError('');
                return true;
            }

            const selectedDate = new Date(`${dateExamInput.value}T00:00:00`);
            const today = new Date();
            today.setHours(0, 0, 0, 0);

            if (selectedDate < today) {
                renderDateError('Date antérieure à aujourd’hui');
                return false;
            }

            renderDateError('');
            return true;
        }

        function getStudentCount(promoId, groupId) {
            if (!studentCounts || !studentCounts[promoId] || typeof studentCounts[promoId][groupId] === 'undefined') {
                return 0;
            }
            return Number(studentCounts[promoId][groupId]);
        }

        function getSalleCapacity(salleId) {
            const salle = sallesData.find((item) => Number(item.id) === Number(salleId));
            return Number(salle && typeof salle.capacite !== 'undefined' ? salle.capacite : 0);
        }

        function exceedsDistinctLimit(key, currentId, maxDistinct) {
            const ids = [];
            existingCombinations.forEach((combination) => {
                const value = Number(combination[key] ?? 0);
                if (value > 0 && !ids.includes(value)) {
                    ids.push(value);
                }
            });

            if (ids.length < maxDistinct) {
                return false;
            }

            return !ids.includes(Number(currentId));
        }

        function hasDuplicateStudents(promoId, groupId) {
            return existingCombinations.some((combination) => {
                if (Number(combination.promo_id) !== Number(promoId)) {
                    return false;
                }

                const existingGroupId = Number(combination.group_id);
                return Number(groupId) === 0 || existingGroupId === 0 || existingGroupId === Number(groupId);
            });
        }

        function roomOverCapacity(salleId, promoId, groupId) {
            const currentCount = getStudentCount(Number(promoId), Number(groupId));
            const usedSeats = existingCombinations.reduce((total, combination) => {
                return Number(combination.salle_id) === Number(salleId)
                    ? total + Number(combination.student_count ?? 0)
                    : total;
            }, currentCount);

            return usedSeats > getSalleCapacity(salleId);
        }

        function evaluateCombinationError() {
            if (!promoSelect || !groupSelect || !matiereSelect || !salleSelect) return '';
            if (promoSelect.value === '' || groupSelect.value === '0' || matiereSelect.value === '' || salleSelect.value === '') return '';

            const promoId = Number(promoSelect.value);
            const groupId = Number(groupSelect ? groupSelect.value || '0' : '0');
            const matiereId = Number(matiereSelect.value);
            const salleId = Number(salleSelect.value);

            if (exceedsDistinctLimit('matiere_id', matiereId, 2)) {
                return 'Le nombre maximum de matière est atteint';
            }

            if (exceedsDistinctLimit('salle_id', salleId, 2)) {
                return 'Le nombre maximum de salle est atteint';
            }

            if (hasDuplicateStudents(promoId, groupId)) {
                return 'Impossible de placer les mêmes élèves plusieurs fois ou à des endroits différents';
            }

            if (roomOverCapacity(salleId, promoId, groupId)) {
                return 'Le nombre de place disponible dans cette salle est insuffisant';
            }

            return '';
        }

        function syncPlacementFilters(resetDependentFields = false) {
            if (!promoSelect) return;
            const promoId = promoSelect.value;
            const showDependentFields = promoId !== '';

            if (fieldGroup) fieldGroup.classList.toggle('is-hidden', !showDependentFields);
            if (fieldMatiere) fieldMatiere.classList.toggle('is-hidden', !showDependentFields);
            if (fieldSalle) fieldSalle.classList.toggle('is-hidden', !showDependentFields);

            if (!showDependentFields) {
                if (groupSelect) groupSelect.value = '0';
                if (matiereSelect) matiereSelect.value = '';
                if (salleSelect) salleSelect.value = '';
                updateAddButtonState();
                return;
            }

            filterSelect(groupSelect, promoId, true);
            filterSelect(matiereSelect, promoId, false);
            if (resetDependentFields) {
                if (groupSelect) groupSelect.value = '0';
                if (matiereSelect) matiereSelect.value = '';
                if (salleSelect) salleSelect.value = '';
            }

            updateAddButtonState();
        }

        if (promoSelect) {
            promoSelect.addEventListener('change', () => {
                syncPlacementFilters(true);
            });
            syncPlacementFilters(false);
        }

        if (groupSelect) {
            groupSelect.addEventListener('change', updateAddButtonState);
        }

        if (matiereSelect) {
            matiereSelect.addEventListener('change', updateAddButtonState);
        }

        if (salleSelect) {
            salleSelect.addEventListener('change', updateAddButtonState);
        }

        if (dateExamInput) {
            dateExamInput.addEventListener('change', () => {
                validateExamDate();
                updateAddButtonState();
            });
            dateExamInput.addEventListener('input', () => {
                if (dateExamInput.value === '') {
                    renderDateError('');
                }
            });
        }

        const tabs = Array.from(document.querySelectorAll('[data-room-tab]'));
        const panels = Array.from(document.querySelectorAll('[data-room-panel]'));
        const rerollForms = Array.from(document.querySelectorAll('.room-reroll-footer'));
        const rerollHeaderForms = Array.from(document.querySelectorAll('.room-reroll-header'));
        const loadingOverlay = document.getElementById('loading-overlay');
        const studentMenuButtons = Array.from(document.querySelectorAll('[data-open-student-menu]'));
        const studentMenus = Array.from(document.querySelectorAll('[data-student-menu]'));
        const closeStudentMenuButtons = Array.from(document.querySelectorAll('[data-close-student-menu]'));
        const addStudentsForms = Array.from(document.querySelectorAll('.add-students-form'));
        const deleteSeatButtons = Array.from(document.querySelectorAll('[data-delete-seat]'));
        const dragHints = Array.from(document.querySelectorAll('[data-drag-hint]'));

        function showLoadingOverlay() {
            if (!loadingOverlay) return;
            loadingOverlay.classList.add('visible');
            loadingOverlay.setAttribute('aria-hidden', 'false');
        }

        function hideLoadingOverlay() {
            if (!loadingOverlay) return;
            loadingOverlay.classList.remove('visible');
            loadingOverlay.setAttribute('aria-hidden', 'true');
        }

        document.querySelectorAll('form').forEach((form) => {
            form.addEventListener('submit', () => {
                if (form === placementSetupForm || form.classList.contains('remove-combination-form') || form.classList.contains('add-students-form')) {
                    return;
                }
                if (form.classList.contains('room-reroll-footer') || form.classList.contains('room-reroll-header')) {
                    sessionStorage.setItem('placementScrollY', String(window.scrollY));
                    return;
                }
                showLoadingOverlay();
            });
        });

        if (placementSetupForm) {
            placementSetupForm.addEventListener('submit', async (event) => {
                const submitter = event.submitter;
                if (!submitter || submitter.value !== 'add_combination') {
                    return;
                }

                event.preventDefault();

                if (!validateExamDate()) {
                    updateAddButtonState();
                    return;
                }

                const formData = new FormData(placementSetupForm);

                try {
                    const response = await fetch('index.php?p=placement_add_combination', {
                        method: 'POST',
                        body: formData
                    });
                    const data = await response.json();

                    renderDateError(data.date_error || '');
                    renderFormError(data.form_error || '');

                    existingCombinations = data.combinations || [];
                    updateCombinationSummary(existingCombinations);

                    if (data.ok && groupSelect) {
                        groupSelect.value = data.form && typeof data.form.group_id !== 'undefined' ? data.form.group_id : '0';
                    }

                    updateAddButtonState();
                } catch (error) {
                    renderFormError('Une erreur est survenue lors de l\'ajout.');
                }
            });
        }

        document.addEventListener('submit', async (event) => {
            const form = event.target;
            if (!(form instanceof HTMLFormElement) || !form.classList.contains('remove-combination-form')) {
                return;
            }

            event.preventDefault();

            try {
                const response = await fetch('index.php?p=placement_remove_combination', {
                    method: 'POST',
                    body: new FormData(form)
                });
                const data = await response.json();

                existingCombinations = data.combinations || [];
                updateCombinationSummary(existingCombinations);
                updateAddButtonState();
            } catch (error) {
                renderFormError('Une erreur est survenue lors de la suppression.');
            }
        });

        tabs.forEach((tab) => {
            tab.addEventListener('click', () => {
                const roomId = tab.dataset.roomTab;
                tabs.forEach((item) => item.classList.toggle('active', item === tab));
                panels.forEach((panel) => panel.classList.toggle('active', panel.dataset.roomPanel === roomId));
                rerollForms.forEach((form) => form.classList.toggle('active', form.dataset.roomReroll === roomId));
                rerollHeaderForms.forEach((form) => form.classList.toggle('active', form.dataset.roomReroll === roomId));
                closeAllStudentMenus();
            });
        });

        function closeAllStudentMenus(exceptRoomId) {
            studentMenus.forEach((menu) => {
                const shouldStayOpen = typeof exceptRoomId !== 'undefined' && menu.dataset.studentMenu === String(exceptRoomId);
                menu.classList.toggle('is-open', shouldStayOpen);
                menu.setAttribute('aria-hidden', shouldStayOpen ? 'false' : 'true');
            });
        }

        function updateAddStudentsSubmitState(form) {
            if (!form) return;
            const submitButton = form.querySelector('[data-add-students-submit]');
            if (!submitButton) return;

            const hasSelection = form.querySelector('input[name="student_ids[]"]:checked') !== null;
            submitButton.disabled = !hasSelection;
        }

        function renderStudentMenuList(roomId, students) {
            const list = document.querySelector(`[data-student-menu-list="${roomId}"]`);
            if (!list) return;

            if (!students.length) {
                list.innerHTML = '<div class="empty-state compact">Tous les étudiants disponibles sont déjà ajoutés.</div>';
                const form = list.closest('form');
                updateAddStudentsSubmitState(form);
                return;
            }

            list.innerHTML = students.map((student) => `
                <label class="student-option">
                    <input type="checkbox" name="student_ids[]" value="${escapeHtml(student.id)}">
                    <span>${escapeHtml(student.display_name)}</span>
                </label>
            `).join('');
            const form = list.closest('form');
            updateAddStudentsSubmitState(form);
        }

        function updateRoomStudentCount(roomId, count) {
            const badge = document.querySelector(`[data-room-student-count="${roomId}"]`);
            if (!badge) return;
            badge.textContent = `${count} étudiant(s) placés`;
        }

        studentMenuButtons.forEach((button) => {
            button.addEventListener('click', (event) => {
                event.stopPropagation();
                const roomId = button.dataset.openStudentMenu;
                const menu = document.querySelector(`[data-student-menu="${roomId}"]`);
                if (!menu) return;
                const willOpen = !menu.classList.contains('is-open');
                closeAllStudentMenus();
                menu.classList.toggle('is-open', willOpen);
                menu.setAttribute('aria-hidden', willOpen ? 'false' : 'true');
            });
        });

        closeStudentMenuButtons.forEach((button) => {
            button.addEventListener('click', () => {
                closeAllStudentMenus();
            });
        });

        addStudentsForms.forEach((form) => {
            updateAddStudentsSubmitState(form);

            form.addEventListener('change', (event) => {
                const target = event.target;
                if (!(target instanceof HTMLInputElement) || target.name !== 'student_ids[]') {
                    return;
                }
                updateAddStudentsSubmitState(form);
            });

            form.addEventListener('submit', async (event) => {
                event.preventDefault();

                const checked = Array.from(form.querySelectorAll('input[name="student_ids[]"]:checked'));
                if (!checked.length) {
                    return;
                }

                try {
                    const response = await fetch('index.php?p=placement_add_students', {
                        method: 'POST',
                        body: new FormData(form)
                    });
                    const data = await response.json();

                    if (!data.ok) {
                        alert(data.message || 'Ajout impossible.');
                        return;
                    }

                    (data.updated_seats || []).forEach((payload) => {
                        const seat = document.querySelector(`.seat[data-room="${data.room_id}"][data-seat-key="${payload.key}"]`);
                        if (!seat) return;
                        const nameNode = seat.querySelector('.seat-name');
                        if (nameNode) {
                            nameNode.textContent = payload.name || '';
                        }
                        seat.classList.toggle('is-empty', !!payload.empty);
                    });

                    updateRoomStudentCount(data.room_id, data.student_count || 0);
                    renderStudentMenuList(data.room_id, data.available_students || []);
                    form.reset();
                    updateAddStudentsSubmitState(form);
                    closeAllStudentMenus();
                } catch (error) {
                    alert('Ajout impossible.');
                }
            });
        });

        document.addEventListener('click', (event) => {
            const target = event.target;
            if (!(target instanceof Element)) {
                return;
            }

            if (target.closest('.student-menu') || target.closest('[data-open-student-menu]')) {
                return;
            }

            closeAllStudentMenus();
        });

        const seats = Array.from(document.querySelectorAll('.seat'));
        let draggedSeat = null;

        function clearDragState() {
            seats.forEach((seat) => {
                seat.classList.remove('dragging');
                seat.classList.remove('drop-target');
            });
            studentMenuButtons.forEach((button) => {
                button.classList.remove('is-hidden-drag');
            });
            rerollHeaderForms.forEach((form) => {
                form.classList.remove('is-hidden-drag');
            });
            dragHints.forEach((hint) => {
                hint.classList.remove('is-hidden-drag');
            });
            deleteSeatButtons.forEach((button) => {
                button.classList.remove('is-delete-ready');
                button.classList.remove('is-delete-target');
            });
            draggedSeat = null;
        }

        async function removeStudentFromSeat(sourceSeat, deleteButton) {
            if (!sourceSeat || !deleteButton) {
                clearDragState();
                return;
            }

            if (sourceSeat.classList.contains('is-empty')) {
                clearDragState();
                return;
            }

            if (sourceSeat.dataset.room !== deleteButton.dataset.deleteSeat) {
                clearDragState();
                return;
            }

            try {
                const body = new URLSearchParams({
                    room_id: sourceSeat.dataset.room,
                    seat_key: sourceSeat.dataset.seatKey
                });

                const response = await fetch('index.php?p=placement_remove_student', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8' },
                    body: body.toString()
                });
                const data = await response.json();

                if (!data.ok) {
                    alert(data.message || 'Suppression impossible.');
                    return;
                }

                const seatName = sourceSeat.querySelector('.seat-name');
                if (seatName) {
                    seatName.textContent = data.seat && data.seat.name ? data.seat.name : '';
                }
                sourceSeat.classList.add('is-empty');
                updateRoomStudentCount(data.room_id, data.student_count || 0);
                renderStudentMenuList(data.room_id, data.available_students || []);
            } catch (error) {
                alert('Suppression impossible.');
            } finally {
                clearDragState();
            }
        }

        async function swapSeats(sourceSeat, targetSeat) {
            if (!sourceSeat || !targetSeat || sourceSeat === targetSeat) {
                clearDragState();
                return;
            }

            if (sourceSeat.dataset.room !== targetSeat.dataset.room) {
                clearDragState();
                return;
            }

            try {
                const body = new URLSearchParams({
                    room_id: sourceSeat.dataset.room,
                    seat_a: sourceSeat.dataset.seatKey,
                    seat_b: targetSeat.dataset.seatKey
                });

                const response = await fetch('index.php?p=placement_swap', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8' },
                    body: body.toString()
                });
                const data = await response.json();

                if (!data.ok) {
                    alert(data.message || 'Interversion impossible.');
                    return;
                }

                [
                    [sourceSeat, data.seatA],
                    [targetSeat, data.seatB]
                ].forEach(([buttonNode, payload]) => {
                    buttonNode.querySelector('.seat-name').textContent = payload.name;
                    buttonNode.classList.toggle('is-empty', !!payload.empty);
                });
            } catch (error) {
                alert('Interversion impossible.');
            } finally {
                clearDragState();
            }
        }

        seats.forEach((seat) => {
            seat.draggable = true;

            seat.addEventListener('dragstart', (event) => {
                if (seat.classList.contains('is-empty')) {
                    event.preventDefault();
                    return;
                }

                draggedSeat = seat;
                seat.classList.add('dragging');
                studentMenuButtons.forEach((button) => {
                    button.classList.add('is-hidden-drag');
                });
                rerollHeaderForms.forEach((form) => {
                    if (form.dataset.roomReroll === seat.dataset.room) {
                        form.classList.add('is-hidden-drag');
                    }
                });
                dragHints.forEach((hint) => {
                    if (hint.dataset.dragHint === seat.dataset.room) {
                        hint.classList.add('is-hidden-drag');
                    }
                });
                deleteSeatButtons.forEach((button) => {
                    if (button.dataset.deleteSeat === seat.dataset.room) {
                        button.classList.add('is-delete-ready');
                    }
                });
                if (event.dataTransfer) {
                    event.dataTransfer.effectAllowed = 'move';
                    event.dataTransfer.setData('text/plain', seat.dataset.seatKey || '');
                }
            });

            seat.addEventListener('dragover', (event) => {
                if (!draggedSeat || draggedSeat === seat || draggedSeat.dataset.room !== seat.dataset.room) {
                    return;
                }
                event.preventDefault();
                if (event.dataTransfer) {
                    event.dataTransfer.dropEffect = 'move';
                }
                seat.classList.add('drop-target');
            });

            seat.addEventListener('dragleave', () => {
                seat.classList.remove('drop-target');
            });

            seat.addEventListener('drop', async (event) => {
                event.preventDefault();
                seat.classList.remove('drop-target');
                await swapSeats(draggedSeat, seat);
            });

            seat.addEventListener('dragend', () => {
                clearDragState();
            });
        });

        deleteSeatButtons.forEach((button) => {
            button.addEventListener('dragover', (event) => {
                if (!draggedSeat || draggedSeat.dataset.room !== button.dataset.deleteSeat) {
                    return;
                }

                event.preventDefault();
                if (event.dataTransfer) {
                    event.dataTransfer.dropEffect = 'move';
                }
                button.classList.add('is-delete-target');
            });

            button.addEventListener('dragleave', () => {
                button.classList.remove('is-delete-target');
            });

            button.addEventListener('drop', async (event) => {
                event.preventDefault();
                button.classList.remove('is-delete-target');
                await removeStudentFromSeat(draggedSeat, button);
            });
        });

        window.addEventListener('pageshow', hideLoadingOverlay);

        const savedScrollY = sessionStorage.getItem('placementScrollY');
        if (savedScrollY !== null) {
            sessionStorage.removeItem('placementScrollY');
            window.requestAnimationFrame(() => {
                window.scrollTo({ top: Number(savedScrollY), behavior: 'auto' });
            });
        }
    })();
</script>
