<section class="stage-panel">
    <div class="section-head">
        <div>
            <h2>Étape 3 : conversion PDF</h2>
        </div>
    </div>

    <div class="export-grid">
        {% for room in placements.rooms %}
            <article class="export-card">
                <h3>{{ room.name }}</h3>
                <div class="summary-line">
                    <span>{{ room.student_count }} étudiant(s)</span>
                    {% if room.supervisor %}
                        <span>{{ room.supervisor }}</span>
                    {% endif %}
                </div>
                <div class="export-links">
                    <a class="btn primary" target="_blank" href="export_pdf.php?devoir={{ devoir_id }}&varD=1&room={{ room.id }}">Liste par Salle</a>
                    <a class="btn primary" target="_blank" href="export_pdf.php?devoir={{ devoir_id }}&varD=2&room={{ room.id }}">Feuille d'Émargement</a>
                    <a class="btn primary" target="_blank" href="export_pdf_salle.php?devoir={{ devoir_id }}&room={{ room.id }}">Plan de Salle</a>
                </div>
            </article>
        {% endfor %}

        {% for promo in placements.promo_exports %}
            <article class="export-card">
                <h3>{{ promo.label }}</h3>
                <div class="summary-line">
                    <span>Export transversal</span>
                    <span>Toutes salles confondues</span>
                </div>
                <div class="export-links">
                    <a class="btn primary" target="_blank" href="export_pdf.php?devoir={{ devoir_id }}&varD=3&promo={{ promo.id }}">Liste par Promotion</a>
                </div>
            </article>
        {% endfor %}
    </div>

    <div class="stage-footer" style="justify-content:flex-start; gap: 10px;">
        <form method="post"><button class="btn primary" type="submit" name="action" value="go_to_placement"> <-- Retour à l'étape précédente</button></form>
    </div>
</section>
